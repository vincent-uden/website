---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Index">
  <div class="h-12"></div>
  <main class="px-8 lg:px-16">
    <h1 class="font-geo text-5xl lg:text-6xl text-pale-grey -translate-x-1">
      HI, I'M VINCENT.
    </h1>

    <div class="h-4"></div>
    <p class="font-gothic text-pale-grey text-lg lg:text-2xl">
      I develop native, cross-platform software such as the pdf reader <a href="https://github.com/vincent-uden/miro" class="text-slate-blue">miro</a>.
    </p>
    <div class="h-8"></div>
    <p class="font-gothic text-pale-grey text-lg lg:text-2xl">
      Contact me using any of the means below or check out my articles
      about tech, programming or whatever it is I'm currently up to.
    </p>
    <div class="h-48"></div>
    <div class="grid font-gothic text-pale-grey text-lg lg:text-xl gap-x-4">
        <p class="text-right">Email</p>
        <p class="text-slate-blue">vincentuden [at] gmail [dot] com</p>
        <p class="text-right">Github</p>
        <a href="https://github.com/vincent-uden"><p class="text-slate-blue">vincent-uden</p></a>
        <p class="text-right">Discord</p>
        <p class="text-slate-blue">vincentuden</p>
        <p class="text-right">X/Twitter</p>
        <a href="https://x.com/vincent_uden"><p class="text-slate-blue">vincent_uden</p></a>
    </div>
  </main>
<style>
    div.grid {
        grid-template-columns: auto auto;
    }
</style>
</Layout>
